{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/briefing", "schedule": "0 11 * * *" },
    { "path": "/api/notify", "schedule": "0 3 * * *" },
    { "path": "/api/notas", "schedule": "0 6 * * *" }
  ]
}
