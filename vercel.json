{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/briefing",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/recover?job=notas",
      "schedule": "0 12 * * *"
    }
  ]
}
